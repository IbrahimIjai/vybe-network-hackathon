{
	"name": "vybe-telegram-bot",
	"version": "1.0.0",
	"description": "Real-time on-chain analytics Telegram bot powered by Vybe APIs",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "ts-node src/index.ts",
		"watch": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts"
	},
	"keywords": [
		"telegram",
		"bot",
		"vybe",
		"crypto",
		"analytics"
	],
	"author": "",
