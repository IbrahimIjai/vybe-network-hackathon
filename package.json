	"dependencies": {
		"axios": "^1.6.0",
		"chart.js": "^4.4.0",
		"chartjs-node-canvas": "^5.0.0",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"grammy": "^1.19.2",
		"moment": "^2.29.4"
	},
	"devDependencies": {
		"@types/express": "^4.17.20",
		"@types/node": "^20.8.10",
		"nodemon": "^3.0.1",
		"ts-node": "^10.9.1",
		"typescript": "^5.2.2"
	}
}
