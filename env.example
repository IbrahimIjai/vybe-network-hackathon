# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Vybe API Key (get from @ericvybes on Telegram)
VYBE_API_KEY=your_vybe_api_key_here

# Server configuration
PORT=3000

# AlphaVybe URL for deep links
ALPHA_VYBE_URL=https://alphavybe.xyz

# Webhook URL for production (leave empty for local development with polling)
# WEBHOOK_URL=https://your-webhook-url.com/bot${BOT_TOKEN}

# WebSocket URL for realtime price updates
PRICE_WEBSOCKET_URL=wss://api.vybe.finance/ws/prices

# Node environment (development or production)
NODE_ENV=development 